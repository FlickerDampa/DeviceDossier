<Window x:Class="DeviceDossier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceDossier" Icon="Assets/DeviceDossier.ico" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="24,28,20,30" Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#3730A3" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Margin="-4">
                            <Canvas Width="256" Height="256">
                                <Path Data="M56,78 a14,14 0 0 1 14,-14 h34 a14,14 0 0 1 11,5.3 l9,11.4 a6,6 0 0 0 4.7,2.3 h57.3 a14,14 0 0 1 14,14 v94 a14,14 0 0 1 -14,14 h-116 a14,14 0 0 1 -14,-14 z" Fill="White" Opacity="0.45"/>
                                <Rectangle Canvas.Left="48" Canvas.Top="104" Width="160" Height="96" RadiusX="16" RadiusY="16" Fill="White"/>
                                <Path Stroke="#2F5BEA" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M116,119 V127 M128,119 V127 M140,119 V127 M116,177 V185 M128,177 V185 M140,177 V185 M95,140 H103 M95,152 H103 M95,164 H103 M153,140 H161 M153,152 H161 M153,164 H161"/>
                                <Rectangle Canvas.Left="104" Canvas.Top="128" Width="48" Height="48" RadiusX="9" RadiusY="9" Fill="#2F5BEA"/>
                                <Rectangle Canvas.Left="117" Canvas.Top="141" Width="22" Height="22" RadiusX="4" RadiusY="4" Fill="White"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DeviceDossier" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Device inventory &amp; audit" Foreground="{DynamicResource SidebarMuted}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                    <Button x:Name="ThemeButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Theme" Click="ThemeToggle_Click" ToolTip="Switch between Match Windows, Light and Dark">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;" FontSize="15" Width="30"/>
                            <TextBlock x:Name="ThemeText" Text="Theme: Match Windows" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="AdminBadge" CornerRadius="10" Padding="14,12" Margin="24,12,24,0" Background="{DynamicResource SidebarHover}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AdminText" Text="Administrator" Foreground="White" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="UserText" Foreground="{DynamicResource SidebarText}" FontSize="11.5" Margin="16,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource SidebarMuted}" FontSize="11" Margin="26,12,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="AUDIT" Foreground="{DynamicResource SidebarMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="26,0,0,8"/>
                    <Button x:Name="NavHome" Style="{StaticResource NavButton}" AutomationProperties.Name="Overview" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="15" Width="30"/>
                            <TextBlock Text="Overview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavProgress" Style="{StaticResource NavButton}" AutomationProperties.Name="Progress" Click="NavProgress_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="15" Width="30"/>
                            <TextBlock Text="Progress" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReport" Style="{StaticResource NavButton}" AutomationProperties.Name="Report" Click="NavReport_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="15" Width="30"/>
                            <TextBlock Text="Report" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="TOOLS" Foreground="{DynamicResource SidebarMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="26,22,0,8"/>
                    <Button x:Name="NavOpen" Style="{StaticResource NavButton}" AutomationProperties.Name="Open saved report" Click="OpenSaved_Click" ToolTip="Open an XML report saved by DeviceDossier on any PC">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="15" Width="30"/>
                            <TextBlock Text="Open saved report" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" AutomationProperties.Name="Settings" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" Width="30"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,32,36,36">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OVERVIEW" Style="{StaticResource Caps}" Foreground="{DynamicResource AccentText}"/>
                            <TextBlock Text="Device overview" Style="{StaticResource H1}" Margin="0,4,0,0"/>
                            <TextBlock Text="Review this PC, choose where the reports should go, then run the audit." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="RefreshSnapshot_Click" AutomationProperties.Name="Refresh system information" ToolTip="Read the system information and USB drives again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border x:Name="LimitedBanner" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Warning}" Margin="0,0,14,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Running without administrator rights" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" FontSize="13.5"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           Text="BitLocker status, drive health, battery capacity, TPM and other users' profiles will be marked as needing administrator rights."/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Restart as administrator" Style="{StaticResource WarningButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="RestartAdmin_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SnapshotLoading" Text="Reading system information..." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                    <ItemsControl x:Name="SpecCards" Margin="0,0,-14,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding SpecColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Badge}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caps}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,6,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Save reports to" Style="{StaticResource H2}"/>
                                    <TextBlock Text="USB drives appear here automatically when they are plugged in." Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,16,-10,0">
                                <RadioButton x:Name="SaveDesktop" GroupName="SaveTo" Style="{StaticResource Choice}" Checked="SaveMode_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Desktop" FontWeight="SemiBold"/>
                                        <TextBlock Text="This user's desktop" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SaveUsb" GroupName="SaveTo" Style="{StaticResource Choice}" Checked="SaveMode_Changed">
                                    <StackPanel>
                                        <TextBlock Text="USB drive" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UsbChoiceHint" Text="Detecting drives..." Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SaveFolder" GroupName="SaveTo" Style="{StaticResource Choice}" Checked="SaveMode_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Choose a folder" FontWeight="SemiBold"/>
                                        <TextBlock Text="Local, network or mapped drive" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <DockPanel x:Name="UsbRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshUsb_Click" AutomationProperties.Name="Refresh USB drives" ToolTip="Look for USB drives again">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <ComboBox x:Name="UsbCombo" SelectionChanged="UsbCombo_SelectionChanged" DisplayMemberPath="Display" AutomationProperties.Name="USB drive"/>
                            </DockPanel>
                            <DockPanel x:Name="FolderRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                                <TextBox x:Name="OutputFolderBox" Style="{StaticResource Input}" TextChanged="OutputFolderBox_TextChanged" AutomationProperties.Name="Report folder"/>
                            </DockPanel>
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="OutputHint" Style="{StaticResource Muted}" FontSize="12"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CloudWarning" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,8,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Warning}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Foreground="{DynamicResource Warning}"
                                               Text="This folder is synced to OneDrive, so the reports (serial numbers, product key, network details) will be uploaded to the cloud. Choose a local folder or a USB drive to keep them off the cloud."/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource IconBadge}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Report formats" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkExcel" Checked="Option_Changed" Unchecked="Option_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Excel workbook (.xlsx)" FontWeight="SemiBold"/>
                                        <TextBlock Text="One formatted sheet for records and the inventory" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ChkHtml" Checked="Option_Changed" Unchecked="Option_Changed">
                                    <StackPanel>
                                        <TextBlock Text="HTML report" FontWeight="SemiBold"/>
                                        <TextBlock Text="Opens in any browser, with search, dark mode and print to PDF" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ChkXml" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="XML data" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reopen in DeviceDossier later, or import into other tools" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource IconBadge}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Include in this audit" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkDrives" Content="Mapped network drives (all user profiles)" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <CheckBox x:Name="ChkSecurity" Content="Security (antivirus, BitLocker, admins, baseline)" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <CheckBox x:Name="ChkPatches" Content="Windows Update history" Checked="Option_Changed" Unchecked="Option_Changed" Margin="28,0,22,12"/>
                                <CheckBox x:Name="ChkSoftware" Content="Installed software" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <CheckBox x:Name="ChkExtensions" Content="Browser extensions" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                           Text="Device, Windows, CPU, memory, graphics, displays, storage, motherboard, power and network are always included."/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Asset details (optional)" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Recorded at the top of the report. Leave empty to skip. Cleared after each audit." Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Asset tag" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AssetTagBox" Style="{StaticResource Input}" AutomationProperties.Name="Asset tag"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Assigned to" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AssignedToBox" Style="{StaticResource Input}" AutomationProperties.Name="Assigned to"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Location / department" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LocationBox" Style="{StaticResource Input}" AutomationProperties.Name="Location or department"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NotesBox" Style="{StaticResource Input}" AutomationProperties.Name="Notes"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="RunTitle" Text="Ready to audit" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="RunHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="RunButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Run audit" Padding="26,13" FontSize="14" Click="Run_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="RunButtonText" Text="Run full audit"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="36,32,36,36" MaxWidth="1000" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="PREFERENCES" Style="{StaticResource Caps}" Foreground="{DynamicResource AccentText}"/>
                            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,4,0,0"/>
                            <TextBlock Text="Defaults used every time DeviceDossier starts. Export them to set up other copies of DeviceDossier the same way." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Import..." Style="{StaticResource SecondaryButton}" Click="ImportSettings_Click"/>
                            <Button Content="Export..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ExportSettings_Click"/>
                            <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Save settings" Margin="8,0,0,0" Click="SaveSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Save settings"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="SettingsStatusBar" CornerRadius="10" Padding="14,11" Margin="0,18,0,0" Background="{DynamicResource SuccessSoft}" Visibility="Collapsed">
                        <TextBlock x:Name="SettingsStatus" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Success}" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Appearance" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SetTheme" Width="320" HorizontalAlignment="Left" SelectionChanged="SetTheme_SelectionChanged">
                                <ComboBoxItem Content="Match Windows"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                            <TextBlock Text="Changes apply straight away. HTML reports follow the light or dark setting of the browser that opens them." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Where reports are saved" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Default location" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SetSaveMode" Width="420" HorizontalAlignment="Left" SelectionChanged="SetSaveMode_SelectionChanged">
                                <ComboBoxItem Content="Desktop"/>
                                <ComboBoxItem Content="USB drive (the one DeviceDossier runs from, or the first found)"/>
                                <ComboBoxItem Content="A specific folder"/>
                            </ComboBox>
                            <StackPanel x:Name="SetFolderPanel">
                                <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SetBrowse_Click"/>
                                    <TextBox x:Name="SetFolder" Style="{StaticResource Input}"/>
                                </DockPanel>
                                <TextBlock Text="Environment variables such as %USERPROFILE% and UNC paths such as \\server\share\Audits are supported." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sub-folder for reports" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SetSubfolder" Style="{StaticResource Input}"/>
                                    <TextBlock Text="Created on the Desktop or USB drive. Leave empty to save directly there." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="File name prefix" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SetPrefix" Style="{StaticResource Input}" TextChanged="SetPrefix_TextChanged"/>
                                    <TextBlock x:Name="SetPrefixHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Default formats" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <CheckBox x:Name="SetExcel" Content="Excel (.xlsx)"/>
                                <CheckBox x:Name="SetHtml" Content="HTML"/>
                                <CheckBox x:Name="SetXml" Content="XML"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="What is collected" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Sections selected by default" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <CheckBox x:Name="SetDrives" Content="Mapped network drives"/>
                                <CheckBox x:Name="SetSecurity" Content="Security"/>
                                <CheckBox x:Name="SetPatches" Content="Windows Update history"/>
                                <CheckBox x:Name="SetSoftware" Content="Installed software"/>
                                <CheckBox x:Name="SetExtensions" Content="Browser extensions"/>
                            </WrapPanel>
                            <TextBlock Text="Privacy and accuracy" Style="{StaticResource FieldLabel}"/>
                            <CheckBox x:Name="SetMaskKey" Content="Mask the Windows product key (show only the last 5 characters)"/>
                            <CheckBox x:Name="SetExcludeTool" Content="Leave the USB drive DeviceDossier runs from out of the storage section"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows Update history timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SetTimeout" Style="{StaticResource Input}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Windows Update timeout in seconds"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Time limit for each section (seconds)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SetStepTimeout" Style="{StaticResource Input}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Section time limit in seconds"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="If Windows stops answering, that section is marked as an error and the audit carries on." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Text="Exclude disks whose model contains (one per line)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SetDisks" Style="{StaticResource InputArea}" Height="84"/>
                            <TextBlock Text="Useful for card readers or docking-station drives that should not count as inventory." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Known file servers" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,10"
                                       Text="Mapped drives that point at these servers are marked as recognised in the report. One server per line as  address = label  - for example  192.168.1.10 = Main file server  or  nas01 = Backup NAS."/>
                            <TextBox x:Name="SetServers" Style="{StaticResource InputArea}" Height="130"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Startup" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="SetAskAdmin" Content="Ask for administrator rights when DeviceDossier starts" Margin="0,16,0,6"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="Without administrator rights DeviceDossier still runs, but BitLocker, drive health, battery wear, TPM and other users' profiles are reported as unavailable."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconBadge}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Settings file" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Restore defaults" Style="{StaticResource SecondaryButton}" Click="ResetSettings_Click"/>
                            </Grid>
                            <TextBox x:Name="SettingsPathText" Style="{StaticResource ValueText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                       Text="Settings are stored next to DeviceDossier.exe so they travel with a USB drive. If that folder is read-only they are stored in your user profile instead."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="15" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Command line" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,10"
                                       Text="Run DeviceDossier unattended from a script, scheduled task, Group Policy or an RMM tool. No window is shown, and the exit code is 0 on success."/>
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <TextBox x:Name="CliText" Style="{StaticResource ValueText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" FontSize="12" Margin="2,18,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ProgressPage" Margin="36,32,36,32" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="AUDIT" Style="{StaticResource Caps}" Foreground="{DynamicResource AccentText}"/>
                    <TextBlock x:Name="ProgressTitle" Text="Auditing" Style="{StaticResource H1}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ProgressSubtitle" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock x:Name="StepText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ElapsedText" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="STEPS" Style="{StaticResource Caps}" Margin="12,10,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="StepsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Neutral}" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="Glyph" Text="{Binding Icon}" Foreground="{DynamicResource TextSubtle}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="StepLabel" Grid.Column="1" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding StateName}" Value="Running">
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="StepLabel" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateName}" Value="Done">
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateName}" Value="Warning">
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource WarningSoft}"/>
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateName}" Value="Failed">
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource DangerSoft}"/>
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateName}" Value="Skipped">
                                                    <Setter TargetName="StepLabel" Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="LIVE LOG" Style="{StaticResource Caps}" Margin="12,10,0,8"/>
                            <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="6,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSubtle}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="Msg" Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Ok">
                                                <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Cancel audit" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ResultPage" Margin="36,32,36,32" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ResultIcon" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SuccessSoft}" VerticalAlignment="Top">
                            <TextBlock x:Name="ResultIconText" Text="✓" Foreground="{DynamicResource Success}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,18,0">
                            <TextBlock x:Name="ResultTitle" Text="Audit complete" Style="{StaticResource H2}" FontSize="19"/>
                            <TextBlock x:Name="ResultSummary" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                            <TextBox x:Name="ResultPath" Style="{StaticResource ValueText}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="ResultNote" Foreground="{DynamicResource Warning}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="OpenExcelButton" Content="Open Excel" Style="{StaticResource PrimaryButton}" Click="OpenExcel_Click"/>
                                <Button x:Name="OpenHtmlButton" Content="Open HTML" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenHtml_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click"/>
                                <Button Content="Save as..." Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="SaveAs_Click" ToolTip="Save this report as Excel, HTML or XML"/>
                                <Button Content="New audit" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="NewAudit_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <TabControl x:Name="ReportTabs" Style="{StaticResource ReportTabs}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
